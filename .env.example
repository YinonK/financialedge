# --- The Brain's AI Council: server-side only. These keys must NEVER be sent to the browser. ---
# Configure any subset. One key = single-model Brain. Two or three = the
# Council: every model analyzes independently, they rebut each other, and a
# chair merges a consensus that surfaces disagreements.
#   GEMINI_API_KEY    — FREE at https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY — paid per-token, https://console.anthropic.com
#   OPENAI_API_KEY    — paid per-token, https://platform.openai.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider speaks with a single voice (chat, briefing, merging council
# output). Defaults to the first configured. Options: gemini|anthropic|openai
AI_CHAIR=

# Optional model overrides (defaults: gemini-2.0-flash / claude-sonnet-5 / gpt-5)
GEMINI_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=

# --- Telegram outbound delivery + bidirectional chat (optional). ---
# If either is missing, briefing/watchdog alerts stub to console log instead
# of sending, and the inbound webhook has nothing to reply through.
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram (/newbot).
# Get TELEGRAM_CHAT_ID by messaging your new bot once, then opening
# https://api.telegram.org/bot<token>/getUpdates and reading "chat":{"id":...},
# or just message @userinfobot to get your own numeric ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra layer of defense on the inbound webhook — any random string.
# If set, it's sent to Telegram at webhook registration and checked on every
# inbound request via the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# The public URL Telegram should POST inbound messages to. Render sets
# RENDER_EXTERNAL_URL automatically once deployed, so you usually don't need
# this — it's for local testing with a tunnel (e.g. ngrok) only.
PUBLIC_BASE_URL=

# --- Telegram channel ingestion (optional) — reads alpha channels Yinon
# follows but doesn't own/administrate. This needs a personal-account MTProto
# session (a bot token alone can't read arbitrary channels). Setup:
#   1. Get TELEGRAM_API_ID + TELEGRAM_API_HASH for free at https://my.telegram.org
#      (log in with your phone -> "API development tools" -> create an app)
#   2. Add both below, then run: npm run telegram:login
#      (one-time interactive login: phone number, code, 2FA password if set)
#   3. Paste the session string it prints into TELEGRAM_SESSION below
#   4. List the channel handles to watch (no @ needed) in TELEGRAM_CHANNELS
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNELS=

# --- Server ---
PORT=3000

# --- Shared secret cron-job.org sends as a header to trigger the weekday
# briefing, the market-hours watchdog, and Telegram channel ingestion — one
# key, one header (X-Cron-Key), reused across all three scheduled jobs. ---
CRON_KEY=change-me
