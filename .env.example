# --- The Brain: server-side only. This key must NEVER be sent to the browser. ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Telegram delivery (optional). If either is missing, briefing delivery is stubbed to console log. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server ---
PORT=3000

# --- Shared secret cron-job.org must send as a header to trigger the weekday briefing. ---
# Generate any random string. Set the same value in cron-job.org's request header X-Briefing-Key.
BRIEFING_KEY=change-me
